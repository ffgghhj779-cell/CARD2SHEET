TELEGRAM_BOT_TOKEN=123456:ABC...
GEMINI_API_KEY=your_gemini_key
# gemini-2.5-flash = fast/cheap; gemini-2.5-pro = max accuracy
GEMINI_MODEL=gemini-2.5-flash

# Google Sheets (service account JSON; share the sheet with its client_email as Editor)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=your_spreadsheet_id
GOOGLE_WORKSHEET=Leads

# Default region for numbers written without a country code (ISO-2)
DEFAULT_PHONE_REGION=SA

# Optional: comma-separated Telegram user IDs allowed to use the bot (empty = everyone)
ALLOWED_USER_IDS=

DB_PATH=leads.db
